# Origin of the NestJS API. In Vercel this points at the api project's URL.
#
# Server-side only, and deliberately not NEXT_PUBLIC_: the browser never calls
# this address. It calls /api on this app's own origin, and next.config.ts
# forwards those requests here — which is what keeps the refresh cookie
# first-party and therefore acceptable to Safari. See the rewrite for why.
API_ORIGIN=http://localhost:3001
