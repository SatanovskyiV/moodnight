# Local API port. Vercel supplies PORT in production.
PORT=3001

# Comma-separated origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# Swagger UI on /docs (raw document on /docs/json). Set to false to hide it.
SWAGGER_ENABLED=true

# Signing keys for the two token kinds. Generate each one separately:
#
#   openssl rand -base64 48
#
# They MUST differ. The refresh token lives for thirty days in a cookie this
# API receives on every /auth request; sharing a secret with the access token
# would let that cookie be replayed as one, and the whole point of the split is
# that it cannot be. The process refuses to start if either is missing.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Optional; these are the defaults. Any ms/vercel duration string works
# ("15m", "1h", "30d"), as does a plain number of seconds.
#
# The access token is short because verifying one touches no database — that is
# what makes a guarded route as cheap as an open one, and the cost is that a
# demotion or a deletion only takes effect when the token expires.
# JWT_ACCESS_TTL=15m
# JWT_REFRESH_TTL=30d

# DATABASE_URL is not listed here on purpose. Locally it is read from
# packages/db/.env — see packages/db/.env.example — so the connection string
# exists once rather than once per app; setting it here would override that.
# In production it is a Vercel environment variable on this project only.
# The process will not start without it.
