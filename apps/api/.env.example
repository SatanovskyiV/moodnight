# Local API port. Vercel supplies PORT in production.
PORT=3001

# Comma-separated origins allowed to call this API.
CORS_ORIGINS=http://localhost:3000

# Swagger UI on /docs (raw document on /docs/json). Set to false to hide it.
SWAGGER_ENABLED=true

# DATABASE_URL is not listed here on purpose. Locally it is read from
# packages/db/.env — see packages/db/.env.example — so the connection string
# exists once rather than once per app; setting it here would override that.
# In production it is a Vercel environment variable on this project only.
# The process will not start without it.
