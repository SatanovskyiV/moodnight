# Database connection for local development. Copy this file to
# packages/db/.env — it is the one place a connection string lives locally, and
# apps/api reads it from here too, so it is never duplicated per app.
#
# In production nothing reads a .env file: Vercel supplies these as project
# environment variables, on the api project only. The web project never
# connects to the database.

# Pooled connection — Neon's "-pooler" host. This is what the application
# connects with: a serverless function opens many short-lived connections and
# the pooler is what keeps them from exhausting Postgres.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-123456-pooler.eu-central-1.aws.neon.tech/moodnight?sslmode=require"

# Unpooled connection to the same database — the identical host without
# "-pooler". Migrations run through this one: PgBouncer in transaction mode
# cannot hold the session-level advisory locks the schema engine takes out.
DIRECT_URL="postgresql://USER:PASSWORD@ep-example-123456.eu-central-1.aws.neon.tech/moodnight?sslmode=require"

# Optional. `prisma migrate dev` needs a throwaway database to detect drift and
# creates one automatically when the role may create databases — which Neon's
# default role may. Set this only if that fails: point it at a scratch database
# (a Neon branch, or a second local one) that migrate may wipe at will.
# SHADOW_DATABASE_URL=

# A local Postgres works too, and needs only the one variable — there is no
# separate pooled endpoint to point DIRECT_URL at:
# DATABASE_URL="postgresql://postgres:postgres@localhost:5432/moodnight"
#
# With no Postgres installed, `pnpm db exec prisma dev` starts one that the
# Prisma CLI ships with — no Docker, no account — and prints the DATABASE_URL
# and SHADOW_DATABASE_URL to paste here.
