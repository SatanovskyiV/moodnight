{
  "name": "@moodnight/db",
  "version": "0.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "postinstall": "prisma generate",
    "generate": "prisma generate",
    "build": "prisma generate && tsc -p tsconfig.json",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src prisma.config.ts scripts",
    "clean": "rm -rf dist .turbo src/generated",
    "seed": "node scripts/local-only.mjs \"pnpm db:seed\" && tsc -p tsconfig.json && node dist/seed.js",
    "db:up": "docker compose -f compose.yaml up -d --wait",
    "db:down": "docker compose -f compose.yaml down",
    "db:nuke": "docker compose -f compose.yaml down --volumes",
    "migrate": "node scripts/local-only.mjs \"pnpm db:migrate\" && prisma migrate dev",
    "migrate:deploy": "prisma migrate deploy",
    "migrate:status": "prisma migrate status",
    "migrate:reset": "node scripts/local-only.mjs \"pnpm db:reset\" && prisma migrate reset",
    "prod:status": "node scripts/prod.mjs migrate status",
    "prod:deploy": "node scripts/prod.mjs migrate deploy",
    "studio": "prisma studio",
    "validate": "prisma validate",
    "format": "prisma format"
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.9.1",
    "@prisma/client": "^7.9.1"
  },
  "devDependencies": {
    "@node-rs/argon2": "^2.0.2",
    "dotenv": "^17.4.2",
    "prisma": "^7.9.1",
    "typescript": "~5.9.3"
  }
}
