// MoodNight's database schema.
//
// The models land here phase by phase (docs/ROADMAP.md, "Data model") — this
// file currently carries only the two blocks every model will depend on, so the
// connection, the generated client and the migration workflow can be set up and
// proven before the first table exists.
//
// Everything about *where* the database is lives in prisma.config.ts and the
// environment, never here: this file is committed and shared, connection
// strings are neither.

generator client {
  // Prisma 7's generator. It emits TypeScript into the package's own source
  // tree, so this package's `tsc` compiles the client together with src/ and
  // ships one consistent build in dist/ — no second toolchain, no runtime
  // dependency on files inside node_modules.
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  // The client only ever runs inside the NestJS function and local scripts.
  // Next.js never imports it: the read path is ISR-cached and talks to the API
  // over HTTP, so no edge or browser build of the client is needed.
  runtime = "nodejs"

  // Match the package's CommonJS output — apps/api compiles to CJS too.
  moduleFormat = "cjs"
}

datasource db {
  // The provider is all this block holds now. Prisma 7 rejects `url` and
  // `directUrl` here: the application connects through the driver adapter in
  // src/client.ts, and the CLI reads its own connection string from
  // prisma.config.ts. Neither of them is a value that belongs in a committed
  // file, which is exactly why the block shrank.
  provider = "postgresql"
}

// Naming convention, set by the first model and followed by every one after
// it: PascalCase model and camelCase fields on the Prisma side, snake_case
// tables and columns in Postgres via `@@map` / `@map`. TypeScript and SQL each
// get to read idiomatically, and neither has to be quoted in psql.

/// What someone is allowed to do, in descending order of privilege. This is the
/// permission — the decorative title on a profile ("Хранитель слова") is a
/// separate display field, and only this enum is ever read by a guard.
enum UserRole {
  /// Everything an editor can do, plus managing users and roles.
  ADMIN

  /// Moderates the queue: approves or rejects other people's poems.
  EDITOR

  /// The default for everyone who registers — writes and publishes their own
  /// poems, moderates nothing.
  AUTHOR

  @@map("user_role")
}

model User {
  id String @id @default(uuid(7)) @db.Uuid

  /// Login identity, and the only field here that has to be globally unique.
  /// Stored lowercased by the application — Postgres compares text
  /// case-sensitively, so `citext` or a lowercasing write path is what makes
  /// the unique index mean what people expect it to.
  email String @unique @db.VarChar(320)

  name    String @db.VarChar(100)
  surname String @db.VarChar(100)

  role UserRole @default(AUTHOR)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Maintained by Prisma on every `update`, not by a database trigger: a row
  /// changed by hand in psql will not move this.
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("users")
}
