// MoodNight's database schema.
//
// The models land here phase by phase (docs/ROADMAP.md, "Data model") — this
// file currently carries only the two blocks every model will depend on, so the
// connection, the generated client and the migration workflow can be set up and
// proven before the first table exists.
//
// Everything about *where* the database is lives in prisma.config.ts and the
// environment, never here: this file is committed and shared, connection
// strings are neither.

generator client {
  // Prisma 7's generator. It emits TypeScript into the package's own source
  // tree, so this package's `tsc` compiles the client together with src/ and
  // ships one consistent build in dist/ — no second toolchain, no runtime
  // dependency on files inside node_modules.
  provider = "prisma-client"
  output   = "../src/generated/prisma"

  // The client only ever runs inside the NestJS function and local scripts.
  // Next.js never imports it: the read path is ISR-cached and talks to the API
  // over HTTP, so no edge or browser build of the client is needed.
  runtime = "nodejs"

  // Match the package's CommonJS output — apps/api compiles to CJS too.
  moduleFormat = "cjs"
}

datasource db {
  // The provider is all this block holds now. Prisma 7 rejects `url` and
  // `directUrl` here: the application connects through the driver adapter in
  // src/client.ts, and the CLI reads its own connection string from
  // prisma.config.ts. Neither of them is a value that belongs in a committed
  // file, which is exactly why the block shrank.
  provider = "postgresql"
}

// Naming convention, set by the first model and followed by every one after
// it: PascalCase model and camelCase fields on the Prisma side, snake_case
// tables and columns in Postgres via `@@map` / `@map`. TypeScript and SQL each
// get to read idiomatically, and neither has to be quoted in psql.

/// What someone is allowed to do, in descending order of privilege. This is the
/// permission — the decorative title on a profile ("Хранитель слова") is a
/// separate display field, and only this enum is ever read by a guard.
enum UserRole {
  /// The site's owner: everything an admin can do, and the account that
  /// answers for the ones an admin should not decide alone.
  ///
  /// There is at most one ROOT row, ever, and that is a database rule rather
  /// than a convention — see the partial unique index below. *Who* may hand the
  /// role over is a separate question, and it has no answer until Phase 3 puts
  /// a guard on the users endpoints.
  ROOT

  /// Everything an editor can do, plus managing users and roles.
  ADMIN

  /// Moderates the queue: approves or rejects other people's poems.
  EDITOR

  /// The default for everyone who registers — writes and publishes their own
  /// poems, moderates nothing.
  AUTHOR

  @@map("user_role")
}

model User {
  id String @id @default(uuid(7)) @db.Uuid

  /// Login identity, and the only field here that has to be globally unique.
  /// Stored lowercased by the application — Postgres compares text
  /// case-sensitively, so `citext` or a lowercasing write path is what makes
  /// the unique index mean what people expect it to.
  email String @unique @db.VarChar(320)

  name    String @db.VarChar(100)
  surname String @db.VarChar(100)

  /// The name a reader sees on a poem — "Орися Вечірня" — which is not the
  /// account's legal name and is not required to resemble it. Backfilled from
  /// `name surname` for accounts that predate the column, so nothing renders
  /// blank; an author changes it the moment they care.
  penName String @map("pen_name") @db.VarChar(100)

  /// The author's address on the public site: `/author/orysia-vechirnia`.
  ///
  /// Derived from `penName` by `slugify` in @moodnight/shared and then owned by
  /// the row — renaming a pen name deliberately does *not* move the slug, since
  /// a URL that has been shared is a promise. Unique, because it addresses one
  /// author and the database is what makes that true under concurrent writes.
  slug String @unique @db.VarChar(120)

  /// Up to two Cyrillic letters for the avatar disc on a poem card. Stored
  /// rather than derived on read: it is a display choice an author may want to
  /// override, and "ОВ" is two characters against a join's worth of work.
  initials String @db.VarChar(8)

  /// The decorative title under the name — "Хранитель слова", "Мандрівний
  /// поет". Pure display, never read by a guard: `role` above is the
  /// permission, and conflating the two is the mistake this comment exists to
  /// prevent. Nullable because an account has no title until somebody gives it
  /// one.
  roleTitle String? @map("role_title") @db.VarChar(100)

  bio String? @db.VarChar(2000)

  /// An R2 object URL once Phase 6 exists. Until then every avatar is the
  /// initials disc, which is why this is nullable and nothing sets it.
  avatarUrl String? @map("avatar_url") @db.VarChar(500)

  /// Argon2id, in PHC string form — which encodes the parameters it was
  /// computed with, so raising the cost settings in apps/api later does not
  /// invalidate the hashes already written here. 255 characters is far more
  /// than the ~100 an argon2id hash occupies.
  ///
  /// Nullable, and that is not laxity. An account can exist without a password:
  /// the seed's do, an admin may create one before its owner has chosen a
  /// password, and the roadmap's Google sign-in never sets one. A null means
  /// "cannot sign in with a password" — never "any password will do", which is
  /// the reading the login path is written to make impossible.
  passwordHash String? @map("password_hash") @db.VarChar(255)

  /// Everyone registers as an AUTHOR; only an explicit write moves an account
  /// up the ladder. ROOT is the one value this column cannot hold twice — see
  /// the note under `@@map`.
  role UserRole @default(AUTHOR)

  /// Whether the account may sign in. This is the site's alternative to
  /// deleting someone, and it is the operation that actually applies to a real
  /// account: `Poem.author` and `Review.reviewer` are both `Restrict`, so
  /// anyone who has written or moderated anything cannot be deleted at all.
  ///
  /// It means *cannot sign in*, and nothing more. Poems already published stay
  /// published — a URL a reader has shared is the same promise `slug` makes —
  /// and taking one down is a change to that poem's `status`, not a
  /// consequence of what happened to its author's account. Nothing on the
  /// public read path looks at this column, deliberately: joining `users` into
  /// the feed's query to check it would cost the `(status, published_at)` index
  /// scan that makes the front page cheap.
  ///
  /// A boolean rather than a nullable `deactivatedAt`, for the reason spelled
  /// out on `Poem.featured`: the administration table filters on this, and
  /// `?active=false` against a nullable timestamp is a presence test the list
  /// framework has no way to express.
  active Boolean @default(true)

  /// What makes signing out mean something without a sessions table.
  ///
  /// Every refresh token carries the value this column held when it was issued,
  /// and is refused once the two disagree. Signing out increments it, so every
  /// refresh token for the account stops verifying at once — on every device,
  /// which is the deliberate trade for not storing sessions. Access tokens are
  /// not checked against it and live out their short TTL.
  tokenVersion Int @default(0) @map("token_version")

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  /// Maintained by Prisma on every `update`, not by a database trigger: a row
  /// changed by hand in psql will not move this.
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  poems   Poem[]
  reviews Review[]

  @@map("users")
}

/// Where a poem is on its way from a draft to a published page.
///
/// The transitions between these belong to Phase 4 and are not enforced by the
/// database — an enum cannot express "PUBLISHED may not go back to DRAFT". What
/// the enum does guarantee is that the column holds nothing else, which is what
/// makes `status: PUBLISHED` safe to use as the public read path's one filter.
enum PoemStatus {
  /// The author's, and nobody else's. Never leaves the studio.
  DRAFT

  /// Submitted, waiting for an editor. Visible in `/admin/queue`.
  PENDING_REVIEW

  /// Public. The only status `GET /poems` will answer with.
  PUBLISHED

  /// An editor said no, with a note on the `Review` row. Back to the author.
  REJECTED

  @@map("poem_status")
}

model Poem {
  id String @id @default(uuid(7)) @db.Uuid

  /// The poem's address: `/poem/tin-nad-polem`. Transliterated from the title
  /// by `slugify` in @moodnight/shared and unique across the site.
  ///
  /// Two poems may honestly share a title, so the application disambiguates
  /// with a suffix before inserting; this index is what makes that check
  /// meaningful rather than a race between two writers submitting at once.
  slug String @unique @db.VarChar(200)

  title String @db.VarChar(200)

  /// The line under the title — "із циклу «Спалені листи»", "балада". Optional,
  /// because most poems do not have one.
  subtitle String? @db.VarChar(200)

  /// The poem itself, newline-separated, as the author typed it. `Text` rather
  /// than a bounded VarChar: a long poem is a normal thing and Postgres stores
  /// both identically anyway.
  ///
  /// Line breaks are the content here, not formatting — which is why this is
  /// plain text and not HTML or Markdown. Nothing renders it as anything but
  /// preformatted lines, so there is no injection surface to sanitise.
  body String @db.Text

  authorId String @map("author_id") @db.Uuid
  /// `Restrict`, and deliberately not `Cascade`: deleting an account must not
  /// silently delete the poems it published. This is the decision the note on
  /// `UsersService.remove` has been deferring — a delete now fails while the
  /// author has poems, and reassigning or archiving them first is a choice
  /// somebody makes on purpose rather than a side effect they discover later.
  author   User   @relation(fields: [authorId], references: [id], onDelete: Restrict)

  status PoemStatus @default(DRAFT)

  /// When the poem became public. Null until it does — which makes it, and not
  /// `createdAt`, the column the public feed orders by: a poem written in March
  /// and approved in August belongs at August's end of the feed.
  publishedAt DateTime? @map("published_at") @db.Timestamptz(3)

  /// When the poem last entered PENDING_REVIEW — what `/admin/queue` orders by.
  ///
  /// A column of its own rather than a reading of `updated_at`, and the queue is
  /// why: an editor is expected to fix a line before approving, and every one of
  /// those edits would push the poem to the back of the queue it is already
  /// being read from. This moves only on the transition into the queue, so a
  /// poem's place in it is the moment its author asked, not the moment anybody
  /// last touched it.
  ///
  /// Never cleared. It answers "when did this last ask to be read", which stays
  /// true after the poem leaves the queue — and a re-submitted poem restamps it,
  /// so it is the *last* request and not the first. Null until a poem is first
  /// submitted, which is the ordinary state of every draft.
  submittedAt DateTime? @map("submitted_at") @db.Timestamptz(3)

  /// Whether an editor has put this poem on the front page — the manual
  /// override over the home page's otherwise automatic sections.
  ///
  /// A plain boolean and not a `featuredAt` timestamp, which was the first
  /// design: the only questions the site asks are "which poems are featured"
  /// and "newest of them first", and `published_at` already answers the second.
  /// A timestamp would have bought a history nothing reads, at the price of a
  /// filter the list framework cannot express — `?featured=true` against a
  /// nullable date is a presence test, and a column of its own value is not.
  featured Boolean @default(false)

  /// A denormalised counter, incremented on read — never a `COUNT(*)` over a
  /// views table. The roadmap names this explicitly, and the reason is the cost
  /// model: this number is rendered on every card in the feed, and a join that
  /// aggregates rows per poem would be the most expensive thing on the busiest
  /// query the site has.
  readCount Int @default(0) @map("read_count")

  tags PoemTag[]

  reviews Review[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  /// The feed's own query: published poems, newest first. A composite index in
  /// the order the planner reads it — equality column first, then the one being
  /// sorted — so the front page is an index scan rather than a sort over every
  /// poem the site has ever held.
  @@index([status, publishedAt(sort: Desc)])
  /// `/author/[slug]`, which is the same page narrowed by one more column.
  @@index([authorId, status, publishedAt(sort: Desc)])
  /// The moderation queue, in the same shape as the feed's index and for the
  /// same reason: one equality column, then the one it is ordered by. Ascending
  /// here rather than descending, because a queue is read oldest first.
  @@index([status, submittedAt])
  @@map("poems")
}

/// A theme a poem belongs to — "Меланхолія", "Сакральне". Curated rather than
/// free-form: tags are how the feed is browsed, and a table of near-duplicates
/// typed by five different people is how that stops working.
model Tag {
  id String @id @default(uuid(7)) @db.Uuid

  /// The displayed Ukrainian name, unique so the same theme cannot exist twice
  /// under two spellings of the same word.
  name String @unique @db.VarChar(60)

  /// `/tag/melankholiia`. Transliterated, and unique for the same reason the
  /// poem's is.
  slug String @unique @db.VarChar(80)

  poems PoemTag[]

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@map("tags")
}

/// The join between the two. An explicit model rather than Prisma's implicit
/// many-to-many, which is the same choice the rest of this schema makes about
/// being able to read the table in psql: an implicit relation creates a
/// `_PoemToTag` table with `A` and `B` columns, and no migration or index on it
/// is ever written by hand again.
model PoemTag {
  poemId String @map("poem_id") @db.Uuid
  poem   Poem   @relation(fields: [poemId], references: [id], onDelete: Cascade)

  tagId String @map("tag_id") @db.Uuid
  /// `Restrict`: removing a tag that poems still carry should fail rather than
  /// quietly unfile them. Unlike the poem side, where a deleted poem genuinely
  /// has no tags left to keep.
  tag   Tag    @relation(fields: [tagId], references: [id], onDelete: Restrict)

  @@id([poemId, tagId])
  /// The reverse direction, for `/tag/[slug]` — the primary key already serves
  /// "which tags does this poem have", and this serves "which poems carry this
  /// tag", which is the one a reader actually asks for.
  @@index([tagId])
  @@map("poem_tags")
}

/// One moderation decision, kept as an audit trail rather than folded into the
/// poem's status. The status says where a poem is now; these say who moved it
/// there and why, which is what a rejected author is owed.
///
/// Phase 4 is what writes these — the model is here because `Poem` and `User`
/// both point at it and adding it later would mean a second migration touching
/// both tables.
model Review {
  id String @id @default(uuid(7)) @db.Uuid

  poemId String @map("poem_id") @db.Uuid
  poem   Poem   @relation(fields: [poemId], references: [id], onDelete: Cascade)

  reviewerId String @map("reviewer_id") @db.Uuid
  reviewer   User   @relation(fields: [reviewerId], references: [id], onDelete: Restrict)

  action ReviewAction

  /// Why. Required for a rejection in the application, optional in the column —
  /// an approval rarely needs words.
  note String? @db.VarChar(2000)

  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  @@index([poemId, createdAt(sort: Desc)])
  @@map("reviews")
}

enum ReviewAction {
  APPROVE
  REJECT

  @@map("review_action")
}

// "At most one ROOT" is enforced by a partial unique index —
//
//   CREATE UNIQUE INDEX "users_one_root" ON "users"("role") WHERE "role" = 'ROOT'
//
// — created by the 20260804121000_one_root_account migration. A `WHERE` clause
// has no equivalent in this file: plain `@@unique([role])` would allow one row
// per role and lock the site to a single author, so the index is written in SQL
// and this comment is the pointer to it.
//
// The cost of living outside the schema: `pnpm db:migrate` diffs the applied
// migrations against this file, sees an index it cannot express, and may
// generate a `DROP INDEX "users_one_root"` into the next migration. Delete that
// line before applying it — the same rule as any other hand-written SQL here.
//
// The API still returns a 409 rather than a raw database error (see
// apps/api/src/users/users.service.ts); the index is what makes that answer
// true under concurrent writes, where a read-then-write check would not be.
